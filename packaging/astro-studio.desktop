[Desktop Entry]
Type=Application
Version=1.0
Name=Astro Studio
GenericName=Astronomical Image Orchestrator
Comment=Zero-processing GUI for astronomical CLI backends
Exec=@EXEC@ %F
Icon=astro-studio
MimeType=image/png;image/jpeg;image/tiff;image/bmp;image/webp;image/fits;image/x-canon-cr2;image/x-nikon-nef;image/x-sony-arw;
Terminal=false
Categories=Science;
Keywords=astronomy;astrophotography;fits;raw;image;
StartupNotify=true
