[Desktop Entry]
Type=Application
Version=1.0
Name=Astro Studio
GenericName=Astronomical Image Orchestrator
Comment=Zero-processing GUI for astronomical CLI backends
Exec=@EXEC@ %F
Icon=astro-studio
MimeType=image/png;image/jpeg;image/tiff;image/bmp;image/webp;image/fits;image/vnd.adobe.photoshop;image/x-psd;image/x-canon-cr2;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-xisf;image/x-sky-ser;video/x-msvideo;
Terminal=false
Categories=Science;
Keywords=astronomy;astrophotography;fits;raw;image;
StartupNotify=true
